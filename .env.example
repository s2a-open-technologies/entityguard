# Optionale Konfiguration (siehe backend/config.py, backend/components/)
TRACE_ENABLED=true
TRACE_RETENTION_DAYS=7
# TRACE_HMAC_SECRET=          # nur setzen, wenn Input-Hashes gewünscht sind
# BERT_NER_DEVICE=cpu         # cpu | cuda | cuda:0 (String, keine Integer)

# Bild-OCR (überschreibt /admin/ocr; für Headless-Container)
# ENTITYGUARD_OCR_ENABLED=true
# ENTITYGUARD_OCR_ENGINE=auto          # auto | tesseract | rapidocr
# ENTITYGUARD_OCR_DEVICE=auto          # auto | cpu | cuda
# ENTITYGUARD_OCR_LANG=deu+eng
# ENTITYGUARD_OCR_REDACTION=line       # entity | line | all_text
# ENTITYGUARD_OCR_MIN_CONFIDENCE=0.5
# ENTITYGUARD_OCR_VERIFY=false
# ENTITYGUARD_IMAGE_MAX_BYTES=10485760
# ENTITYGUARD_IMAGE_MAX_PIXELS=40000000
# ENTITYGUARD_OCR_TIMEOUT_SECONDS=30
# ENTITYGUARD_TESSERACT_CMD=tesseract

# Image-Tag für docker-compose (latest | latest-cpu | 1.1.1 | 1.1.1-cpu | edge)
# ENTITYGUARD_TAG=latest-cpu
